<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar PDF" Width="480" Height="620"
        MinHeight="400" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ============ GERAL ============ -->
            <TabItem Header="Geral">
                <StackPanel Margin="10">
                    <GroupBox Header="Pasta de destino">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_folder" Grid.Column="0" IsReadOnly="True"/>
                            <Button x:Name="btn_browse" Grid.Column="1" Content="Procurar..."
                                    Margin="5,3,0,3" Padding="10,2" Click="on_browse"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ============ PDF ============ -->
            <TabItem x:Name="tab_pdf" Header="PDF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <GroupBox Header="Arquivo">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="chk_combine" Grid.Row="0" Grid.ColumnSpan="2"
                                          Content="Combinar todas as pranchas em um único PDF"
                                          Checked="on_combine_changed" Unchecked="on_combine_changed"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Nome do arquivo (se combinar)"/>
                                <TextBox x:Name="txt_filename" Grid.Row="1" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Papel e escala">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Formato do papel"/>
                                <ComboBox x:Name="cmb_paper_format" Grid.Row="0" Grid.Column="1"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Orientação"/>
                                <ComboBox x:Name="cmb_orientation" Grid.Row="1" Grid.Column="1"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Posicionamento no papel"/>
                                <ComboBox x:Name="cmb_placement" Grid.Row="2" Grid.Column="1"
                                          SelectionChanged="on_placement_changed"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="Deslocamento X (mm)"/>
                                <TextBox x:Name="txt_offset_x" Grid.Row="3" Grid.Column="1" Text="0"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="Deslocamento Y (mm)"/>
                                <TextBox x:Name="txt_offset_y" Grid.Row="4" Grid.Column="1" Text="0"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="Tipo de zoom"/>
                                <ComboBox x:Name="cmb_zoom_type" Grid.Row="5" Grid.Column="1"
                                          SelectionChanged="on_zoom_type_changed"/>

                                <Label Grid.Row="6" Grid.Column="0" Content="Zoom (%)"/>
                                <TextBox x:Name="txt_zoom" Grid.Row="6" Grid.Column="1" Text="100"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Qualidade">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Profundidade de cor"/>
                                <ComboBox x:Name="cmb_color_depth" Grid.Row="0" Grid.Column="1"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Qualidade de exportação (DPI)"/>
                                <ComboBox x:Name="cmb_export_quality" Grid.Row="1" Grid.Column="1"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Qualidade raster (DPI)"/>
                                <ComboBox x:Name="cmb_raster_quality" Grid.Row="2" Grid.Column="1"/>

                                <CheckBox x:Name="chk_always_raster" Grid.Row="3" Grid.ColumnSpan="2"
                                          Content="Sempre usar raster (em vez de vetor)"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Ocultar e opções">
                            <StackPanel>
                                <CheckBox x:Name="chk_hide_crop" Content="Ocultar limites de corte" IsChecked="True"/>
                                <CheckBox x:Name="chk_hide_refplane" Content="Ocultar planos de referência" IsChecked="True"/>
                                <CheckBox x:Name="chk_hide_scopebox" Content="Ocultar caixas de escopo" IsChecked="True"/>
                                <CheckBox x:Name="chk_hide_unref_tags" Content="Ocultar marcas de vista sem referência" IsChecked="True"/>
                                <CheckBox x:Name="chk_mask_coincident" Content="Mascarar linhas coincidentes"/>
                                <CheckBox x:Name="chk_halftone_thin" Content="Substituir meio-tom por linhas finas"/>
                                <CheckBox x:Name="chk_view_links_blue" Content="Vínculos de vista em azul"/>
                                <CheckBox x:Name="chk_stop_on_error" Content="Parar a exportação se uma vista falhar"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ============ BOTÕES ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_ok" Content="Exportar" Width="90" Padding="4"
                    IsDefault="True" Click="on_ok"/>
            <Button x:Name="btn_cancel" Content="Cancelar" Width="90" Padding="4"
                    Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
        </StackPanel>
    </Grid>
</Window>
